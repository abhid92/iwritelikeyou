{
  "version": 2,
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/auth/:path*",  "destination": "/api/auth"  },
    { "source": "/admin",            "destination": "/admin.html" },
    { "source": "/((?!api|admin).*)", "destination": "/index.html" }
  ]
}
